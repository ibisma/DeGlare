# Dataset images are distributed via GitHub Releases, not tracked in git.
# Directories must be re-included (!dataset/**/) or git never descends into them
# and the .gitkeep negations below would have no effect.
dataset/**
!dataset/**/
!dataset/README.md
!dataset/**/.gitkeep

# Release archives
*.zip
*.tar
*.tar.gz
*.7z

# Model weights and checkpoints
*.pt
*.pth
*.ckpt
*.onnx
*.h5

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Experiment output
runs/
logs/
wandb/
outputs/

# OS and editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
